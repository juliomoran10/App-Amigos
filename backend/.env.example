# Neon PostgreSQL (Dashboard → Connection details → Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

PORT=4000
# Origen permitido para CORS y Socket.io (en producción usa el dominio del frontend)
CORS_ORIGIN=*

JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=5m

# Cloudinary (opcional). Si no se configura, las imágenes se guardan en /uploads localmente.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo (Resend) para recuperación de contraseña
# En prueba gratis solo puedes enviar a tu email verificado con onboarding@resend.dev
RESEND_API_KEY=re_xxxxxxxx
EMAIL=onboarding@resend.dev

# Deep link de la app móvil (debe coincidir con scheme en app.json)
MOBILE_APP_URL=friendmatch://

# Si no tienes Resend aún, el enlace de recuperación se imprime en la consola del backend
MAIL_DEV_LOG=true
